APP_NAME="Oil Change POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=central
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# The central control-plane database may use its own SQLite file or MySQL database.
# CENTRAL_DB_URL is optional and never falls back to the generic DB_URL.
CENTRAL_DB_CONNECTION=sqlite
# CENTRAL_DB_URL=
# CENTRAL_DB_HOST=127.0.0.1
# CENTRAL_DB_PORT=3306
# CENTRAL_DB_DATABASE=database/central.sqlite
# CENTRAL_DB_USERNAME=root
# CENTRAL_DB_PASSWORD=
# CENTRAL_DB_FOREIGN_KEYS=true
# CENTRAL_MYSQL_ATTR_SSL_CA=

# Per-shop values replace this tenant template at runtime. TENANT_DB_URL is
# intentionally unsupported because a URL would override the selected shop.
# TENANT_DB_CONNECTION=sqlite
# TENANT_SQLITE_ROOT=/absolute/path/to/tenant-databases
# TENANT_DB_HOST=127.0.0.1
# TENANT_DB_PORT=3306
# TENANT_DB_DATABASE=database/tenant.sqlite
# TENANT_DB_USERNAME=root
# TENANT_DB_PASSWORD=
# TENANT_DB_FOREIGN_KEYS=true
# TENANT_PROVISIONING_LOCK_SECONDS=900
# TENANT_MYSQL_REMOTE_PROVISIONING_ENABLED=false
# TENANT_MYSQL_ATTR_SSL_CA=
# TENANT_MYSQL_VERIFY_SERVER_CERT=true

SESSION_DRIVER=database
SESSION_CONNECTION=central
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Production support access across shop subdomains requires the central host,
# including a leading dot if preferred (for example, .pos.example.com).
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_CONNECTION=central

CACHE_STORE=database
DB_CACHE_CONNECTION=central
DB_CACHE_LOCK_CONNECTION=central
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
